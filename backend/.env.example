APP_NAME=PredictAI | Gestão de Manutenção
APP_VERSION=1.0.0
APP_ENV=development

# PostgreSQL connection details. Keep credentials outside the URL.
DATABASE_URL=postgresql://localhost:5432/predictai
DATABASE_USER=postgres
DATABASE_PASSWORD="coloque_a_senha_do_banco_aqui"
DATABASE_MIN_POOL_SIZE=1
DATABASE_MAX_POOL_SIZE=10

# Generate a unique random key for each environment.
SECRET_KEY=gere_uma_chave_aleatoria_com_pelo_menos_32_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_PASSWORD_TOKEN_EXPIRE_MINUTES=5

# SMTP credentials. Replace every placeholder before enabling password recovery.
SMTP_HOST=seu_servidor_smtp
SMTP_PORT=587
SMTP_USER=seu_email@dominio.com
SMTP_PASSWORD=sua_senha_de_aplicativo_aqui
EMAILS_FROM_EMAIL=seu_email@dominio.com
EMAILS_FROM_NAME="Suporte Manutenção"

# Frontend route that receives the reset token.
FRONTEND_URL=http://localhost:3000/reset-password

# IA Groq para orientações de manutenção baseadas nos manuais.
# A chave fica somente no backend; nunca use o prefixo NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
