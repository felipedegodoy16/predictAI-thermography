APP_NAME=Thermal Monitoring API
APP_VERSION=1.0.0
APP_ENV=development

# URL sem usuário e senha; inclua host, porta e nome do banco.
DATABASE_URL=postgresql://localhost:5432/thermal_monitoring
DATABASE_USER=postgres
DATABASE_PASSWORD="coloque_a_senha_do_banco_aqui"
DATABASE_MIN_POOL_SIZE=1
DATABASE_MAX_POOL_SIZE=10

# Gere uma chave aleatória para cada ambiente; não reutilize este texto de exemplo.
SECRET_KEY=gere_uma_chave_aleatoria_com_pelo_menos_32_caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
